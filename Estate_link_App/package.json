{
  "name": "EstateLink",
  "version": "1.0.0",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "prebuild": "expo prebuild",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:aab:local": "eas build --profile production --platform android --local",
    "build:aab:gradle": "bash fix-manifest.sh && cd android && ./gradlew bundleRelease",
    "build:apk:local": "bash fix-manifest.sh && cd android && ./gradlew assembleRelease",
    "build:apk:debug": "cd android && ./gradlew assembleDebug",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build:ios:local": "expo run:ios --configuration Release",
    "build:ios:production": "eas build --profile production --platform ios",
    "build:ios:production:local": "eas build --profile production --platform ios --local",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:ios:production": "eas submit --platform ios --latest --profile production",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "test": "jest",
    "test:passing": "jest --config jest.config.passing.js",
    "test:clean": "jest --config jest.config.clean.js",
    "test:minimal": "jest --config jest.config.minimal.js",
    "test:final": "jest --config jest.config.final.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:noticeboard": "jest --config jest.config.simple.js noticeboard.test.js ShowNoticeBoard.test.js --verbose",
    "test:dashboard": "jest --config jest.config.simple.js dashboard.test.js --verbose",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/lato": "^0.4.1",
    "@expo-google-fonts/oxanium": "^0.4.1",
    "@expo/config": "^12.0.9",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-firebase/app": "^23.8.4",
    "@react-native-firebase/messaging": "^23.8.4",
    "@react-navigation/bottom-tabs": "^7.8.1",
    "@react-navigation/native": "^7.1.22",
    "@react-navigation/native-stack": "^7.3.25",
    "@react-navigation/stack": "^7.4.4",
    "@reduxjs/toolkit": "^2.2.1",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.16",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-icons": "^5.5.0",
    "react-native": "0.81.5",
    "react-native-blob-util": "^0.22.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-pdf": "^6.7.7",
    "react-native-reanimated": "~4.1.1",
    "react-native-responsive-screen": "^1.4.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1",
    "react-redux": "^9.1.0",
    "redux-persist": "^6.0.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^24.7.2",
    "@types/react": "~19.1.10",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.2",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "jest-summary-reporter": "^0.0.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.1",
    "typescript": "~5.9.2"
  },
  "main": "node_modules/expo/AppEntry.js",
  "private": true
}
