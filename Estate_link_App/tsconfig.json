{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "es6"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "jest",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "src/*"
      ],
      "components": [
        "components"
      ],
      "components/*": [
        "components/*"
      ],
      "store/*": [
        "src/store/*"
      ],
      "hooks/*": [
        "src/hooks/*"
      ],
      "validation/*": [
        "src/validation/*"
      ],
      "types/*": [
        "src/types/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "nativewind-env.d.ts",
    "jest.d.ts"
  ],
  "exclude": [
    "node_modules",
    "node_modules/expo-image-picker/tsconfig.json"
  ],
  "extends": "expo/tsconfig.base"
}
